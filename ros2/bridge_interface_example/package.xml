<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
    <name>bridge_interface_example</name>
    <version>1.0.0</version>
    <description>Package which demonstrates the way in which local packages can be built and bridged</description>
    <maintainer email="alexnavtt@utexas.edu">alex</maintainer>
    <license>BSD</license>

    <buildtool_depend>ament_cmake</buildtool_depend>
    
    <depend>rclcpp</depend>
    <depend>builtin_interfaces</depend>
    <depend>rosidl_typesupport_cpp</depend>
    <depend>rosidl_default_generators</depend>
    
    <member_of_group>rosidl_interface_packages</member_of_group>

    <export>
        <build_type>ament_cmake</build_type>
    </export>
</package>